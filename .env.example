HOST=0.0.0.0
PORT=1337

# Buat 4 key acak: openssl rand -base64 16   (gabung dengan koma untuk APP_KEYS)
APP_KEYS="key1,key2,key3,key4"
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Lokal: sqlite (default). Produksi: postgres (Neon/Supabase)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# Produksi (contoh Neon):
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DATABASE_SSL=true

# Produksi di balik proxy (Render): URL publik Strapi
# PUBLIC_URL=https://avoo-cms.onrender.com

# Isi konten awal sekali saja, lalu HAPUS variabel ini:
# SEED_ON_BOOT=true
