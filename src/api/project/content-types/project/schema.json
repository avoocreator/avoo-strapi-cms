{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "number": {
      "type": "string",
      "maxLength": 10
    },
    "title_id": {
      "type": "string",
      "maxLength": 120,
      "required": true
    },
    "title_en": {
      "type": "string",
      "maxLength": 120
    },
    "category_id": {
      "type": "string",
      "maxLength": 60,
      "required": true
    },
    "category_en": {
      "type": "string",
      "maxLength": 60
    },
    "description_id": {
      "type": "text",
      "required": true
    },
    "description_en": {
      "type": "text"
    },
    "tags": {
      "type": "json"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "selesai",
        "berjalan",
        "riset",
        "konsep"
      ],
      "default": "konsep"
    },
    "year": {
      "type": "string",
      "maxLength": 10
    },
    "link": {
      "type": "string",
      "maxLength": 255
    }
  }
}